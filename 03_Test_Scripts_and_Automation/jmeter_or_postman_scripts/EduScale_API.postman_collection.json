{
  "info": {
    "name": "EduScale API – Complete Test Collection",
    "description": "Koleksi pengujian API lengkap untuk sistem EduScale School Management System.\nMencakup: Authentication, Students, Teachers, Classes, Subjects, BK, Dashboard, Users, Academic Year, Audit Log.\n\nCara menjalankan:\n- Postman: Import collection + environment, lalu run dengan Collection Runner\n- Newman: newman run EduScale_API.postman_collection.json -e EduScale_Env.postman_environment.json --reporters html,cli\n\nKelompok 7 – Final Project QA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "eduscale-kelompok7"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "studentId", "value": "", "type": "string" },
    { "key": "teacherId", "value": "", "type": "string" },
    { "key": "classId", "value": "", "type": "string" },
    { "key": "bkCaseId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01 – Authentication",
      "item": [
        {
          "name": "POST Login (Valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Punya token', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('token');",
                  "  pm.expect(json.token).to.be.a('string');",
                  "  pm.collectionVariables.set('token', json.token);",
                  "});",
                  "pm.test('Punya user', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('user');",
                  "  pm.expect(json.user).to.have.property('email');",
                  "});",
                  "pm.test('Response time < 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@eduscale.id\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "POST Login (Invalid Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Ada pesan error', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('message');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@eduscale.id\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
